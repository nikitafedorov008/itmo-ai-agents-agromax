          "url",
          "name",
          "mimeType"
        ],
        "additionalProperties": false
      },
      "Observation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fieldId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
