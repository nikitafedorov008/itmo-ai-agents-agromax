          "fieldId",
          "note",
          "photoIds",
          "status",
          "version",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fieldId": {
            "type": "string"
          },
          "observationId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dueAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done"
