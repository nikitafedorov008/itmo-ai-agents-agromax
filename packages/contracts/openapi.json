            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "approved"
            ]
          },
          "version": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "approvedAt": {
            "type": "string"
          },
