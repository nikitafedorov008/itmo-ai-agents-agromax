{
  "name": "itmo-ai-agents-agromax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @agromax/api",
    "dev:web": "npm run dev -w @agromax/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts:generate": "node tools/generate-contracts.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "dev": "node tools/dev.mjs",
    "setup:local": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime && node tools/configure-local.mjs",
    "check:integration": "node tools/smoke.mjs && node tools/check-security.mjs",
    "check:models": "node tools/check-models.mjs",
    "check:workbench": "node tools/check-workbench.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "supabase": "^2.121.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
